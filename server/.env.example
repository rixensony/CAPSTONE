# SkillBridge API environment variables (example — no real secrets)
# Copy this file to .env and fill in real values. .env is git-ignored.

# Port the Express server listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (local mongod or a MongoDB Atlas cluster).
# If the password contains special characters, URL-encode them.
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# JWT signing secret. Use a long random string; never commit the real value.
JWT_SECRET=replace-with-a-long-random-string-generation-openssl-rand-hex-64

# Token lifetime
JWT_EXPIRES_IN=7d

# Login/register rate limiting (per browser IP). Defaults: 50 attempts / 15 min.
AUTH_RATE_MAX=50
AUTH_RATE_WINDOW_MINUTES=15

# CORS: comma-separated list of allowed browser origins (update after deploying)
CLIENT_URL=http://localhost:5173

# Seed script: when set, the seed script uses this password for every demo user;
# otherwise it generates and prints random ones (no test passwords live in the repo).
# SEED_PASSWORD=
